-- BusyBox shell command-line grammar for BNFC's C backend.
-- Step 2 grammar: simple commands, variables, command substitution, simple
-- if/then/fi, pipelines, redirection, background jobs, and semicolon-separated
-- jobs. Execution still lives in busybox_shell/main.c.

comment "/*" "*/" ;
comment "//" "\n" ;

token Word ((letter | digit | '_' | '.' | '/' | '-' | '\\')+) ;

entrypoints Input ;

StartInput. Input ::= [Job] ;

ForegroundJob. Job ::= CommandLine ;
BackgroundJob. Job ::= CommandLine "&" ;
AssignmentJob. Job ::= Assignment ;
IfJob. Job ::= IfStatement ;

separator nonempty Job ";" ;

SetVariable. Assignment ::= Word "=" Arg ;

IfThenFi. IfStatement ::= "if" CommandLine "then" [Job] "fi" ;

CommandWithRedir. CommandLine ::= Pipeline [Redirection] ;

SingleCommand. Pipeline ::= CommandPart ;
PipeCommand. Pipeline ::= CommandPart "|" Pipeline ;

MkCommandPart. CommandPart ::= Word [Arg] ;

WordArg. Arg ::= Word ;
VariableArg. Arg ::= "$" Word ;
SubcommandArg. Arg ::= "`" Word [Word] "`" ;

separator Arg " " ;
separator Word " " ;

InputRedirection. Redirection ::= "<" Word ;
OutputRedirection. Redirection ::= ">" Word ;

terminator Redirection "" ;
